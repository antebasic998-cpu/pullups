+// empty when interop isn't enabled, so non-interop C++ consumers can include
+// this header normally.
+#if __has_include(<swift/bridging>)
+#include <swift/bridging>
+#else
+#define SWIFT_RETURNS_INDEPENDENT_VALUE
+#endif
